# ==========================================
# Backend — Pruna AI
# ==========================================
PRUNA_AI_API_KEY=your_pruna_api_key_here

# ==========================================
# Backend — CORS (comma-separated origins)
# Add your Vercel frontend URL here:
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# Frontend — API Base URL (optional)
# Only needed if backend is hosted separately
# e.g. on Railway, Render, Fly.io, etc.
# Leave empty when using Vite dev proxy (local)
# ==========================================
VITE_API_BASE_URL=
